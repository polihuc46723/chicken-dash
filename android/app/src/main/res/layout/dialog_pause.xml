<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pause_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/screen_margin">

    <LinearLayout
        android:id="@+id/pause_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/surface_dialog"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding">

        <TextView
            android:id="@+id/pause_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dialog_pause_title"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_resume"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/dialog_pause_resume"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_quit"
            style="@style/Widget.App.Button.Chip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_pause_quit" />

    </LinearLayout>

</RelativeLayout>
