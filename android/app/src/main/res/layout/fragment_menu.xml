<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/root_padding_bottom">

    <ImageView
        android:id="@+id/menu_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.35"
        android:contentDescription="@string/cd_background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_menu"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/menu_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_height"
        android:orientation="horizontal"
        android:paddingTop="@dimen/header_padding_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/menu_logo"
            android:layout_width="@dimen/logo_header"
            android:layout_height="@dimen/logo_header"
            android:contentDescription="@string/cd_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/menu_wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/splash_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.Kelzuni2.Vorqet.core.ui.StatCardView
            android:id="@+id/menu_streak"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            app:appAccent="@color/primary_blue"
            app:appCompact="true"
            app:appLabel="@string/label_streak" />

    </LinearLayout>

    <View
        android:id="@+id/menu_hairline"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/hairline_mint"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_header" />

    <LinearLayout
        android:id="@+id/menu_greeting_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/menu_goal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_hairline"
        app:layout_constraintVertical_bias="0.35">

        <TextView
            android:id="@+id/menu_greeting_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_greeting_caption"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <TextView
            android:id="@+id/menu_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/menu_greeting"
            android:textAppearance="@style/TextAppearance.App.Headline" />

    </LinearLayout>

    <com.Kelzuni2.Vorqet.core.ui.GoalProgressView
        android:id="@+id/menu_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_medium"
        app:layout_constraintBottom_toTopOf="@id/menu_stat_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/menu_stat_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_large"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/menu_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.Kelzuni2.Vorqet.core.ui.StatCardView
            android:id="@+id/menu_stat_best"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_tiny"
            android:layout_weight="1"
            app:appAccent="@color/primary_blue"
            app:appLabel="@string/label_best" />

        <com.Kelzuni2.Vorqet.core.ui.StatCardView
            android:id="@+id/menu_stat_blooms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tiny"
            android:layout_weight="1"
            app:appAccent="@color/accent_mint"
            app:appLabel="@string/label_blooms" />

    </LinearLayout>

    <TextView
        android:id="@+id/menu_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_small"
        android:gravity="center"
        android:text="@string/menu_hint"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/menu_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_play"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/cta_tile_height"
        android:layout_marginBottom="@dimen/gap_xlarge"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/menu_cta"
        app:icon="@drawable/ic_sprout"
        app:layout_constraintBottom_toTopOf="@id/menu_chip_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/menu_chip_row"
        android:layout_width="0dp"
        android:layout_height="@dimen/chip_height"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_chip_history"
            style="@style/Widget.App.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/menu_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_chip_settings"
            style="@style/Widget.App.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:text="@string/menu_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_chip_rules"
            style="@style/Widget.App.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:text="@string/menu_rules" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
