<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stat_card"
        style="@style/Widget.App.Card.Tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/stat_dot"
                android:layout_width="@dimen/accent_dot"
                android:layout_height="@dimen/accent_dot"
                android:layout_marginBottom="6dp"
                android:background="@drawable/dot_accent"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/stat_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/settings_target_10"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/primary_blue" />

            <TextView
                android:id="@+id/stat_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/label_best"
                android:textAppearance="@style/TextAppearance.App.Label" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
