<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/result_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/root_padding_bottom">

    <ImageView
        android:id="@+id/result_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.42"
        android:contentDescription="@string/cd_background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/result_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_result"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/result_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:paddingTop="@dimen/header_padding_top"
        android:text="@string/label_harvest"
        android:textAppearance="@style/TextAppearance.App.Label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/result_hero"
        style="@style/Widget.App.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/result_goal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_header"
        app:layout_constraintVertical_bias="0.3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/result_sprite_a"
                    android:layout_width="@dimen/hero_sprite"
                    android:layout_height="@dimen/hero_sprite"
                    android:alpha="0"
                    android:contentDescription="@string/cd_plant"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_2" />

                <ImageView
                    android:id="@+id/result_sprite_b"
                    android:layout_width="@dimen/hero_sprite"
                    android:layout_height="@dimen/hero_sprite"
                    android:layout_marginStart="12dp"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_4" />

                <ImageView
                    android:id="@+id/result_sprite_c"
                    android:layout_width="@dimen/hero_sprite"
                    android:layout_height="@dimen/hero_sprite"
                    android:layout_marginStart="12dp"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_5" />

            </LinearLayout>

            <TextView
                android:id="@+id/result_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/primary_blue"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_score_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_points_session"
                android:textAppearance="@style/TextAppearance.App.Label" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.Kelzuni2.Vorqet.core.ui.GoalProgressView
        android:id="@+id/result_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_medium"
        app:layout_constraintBottom_toTopOf="@id/result_stat_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/result_stat_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_large"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/result_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.Kelzuni2.Vorqet.core.ui.StatCardView
            android:id="@+id/result_stat_blooms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_tiny"
            android:layout_weight="1"
            app:appAccent="@color/accent_mint"
            app:appLabel="@string/label_blooms" />

        <com.Kelzuni2.Vorqet.core.ui.StatCardView
            android:id="@+id/result_stat_combo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tiny"
            android:layout_marginEnd="@dimen/gap_tiny"
            android:layout_weight="1"
            app:appAccent="@color/primary_blue"
            app:appLabel="@string/label_best_combo" />

        <com.Kelzuni2.Vorqet.core.ui.StatCardView
            android:id="@+id/result_stat_accuracy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tiny"
            android:layout_weight="1"
            app:appAccent="@color/state_coral"
            app:appLabel="@string/label_accuracy" />

    </LinearLayout>

    <TextView
        android:id="@+id/result_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_small"
        android:gravity="center"
        android:text="@string/result_hint"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink_tertiary"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/result_replay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/result_replay"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/cta_tile_height"
        android:layout_marginBottom="@dimen/gap_xlarge"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/result_replay"
        app:icon="@drawable/ic_sprout"
        app:layout_constraintBottom_toTopOf="@id/result_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/result_menu"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/secondary_height"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/result_menu"
        app:icon="@drawable/icon_home"
        app:iconTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
