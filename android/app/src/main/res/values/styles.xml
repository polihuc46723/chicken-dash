<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/ink_primary</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:letterSpacing">0.26</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_tertiary</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/primary_blue</item>
        <item name="cornerRadius">@dimen/card_radius</item>
        <item name="elevation">@dimen/elevation_cta</item>
        <item name="iconTint">@color/surface_white</item>
        <item name="iconSize">@dimen/icon_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="android:stateListAnimator">@animator/btn_press</item>
        <item name="rippleColor">@color/primary_blue_soft</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary_blue</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:lineHeight">24dp</item>
        <item name="backgroundTint">@color/primary_blue_soft</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconTint">@color/primary_blue</item>
        <item name="iconSize">@dimen/icon_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="android:stateListAnimator">@animator/btn_press</item>
    </style>

    <style name="Widget.App.Button.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/stroke_hair</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/surface_white</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="strokeColor">@color/stroke_hair</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/stroke_hair</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.App.Card.Tile" parent="Widget.App.Card">
        <item name="cardCornerRadius">@dimen/card_radius_small</item>
        <item name="cardElevation">1dp</item>
    </style>
</resources>
